generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enumeraciones ───────────────────────────────────────────────────────────

enum Role {
  APPLICANT
  INSPECTOR
  CAJERO
  ADMIN
  DEVELOPER
}

enum ApplicationStatus {
  DRAFT
  DOCUMENTS_COMPLETE
  PENDING_PAYMENT
  PAYMENT_COMPLETED
  INSPECTION_SCHEDULED
  FIRST_INSPECTION_REJECTED
  SECOND_INSPECTION_SCHEDULED
  LICENSE_ISSUED
  DEFINITIVELY_REJECTED
  RENEWAL_AVAILABLE
  EXPIRED
  // Licencia dada de baja en ventanilla. No entra en OPEN_APPLICATION_STATUSES
  // ni en LICENSED_STATUSES, y por eso el RUC queda libre para un trámite
  // nuevo sin tocar findBlockingApplicationByRuc.
  CANCELLED
}

enum LicenseStatus {
  ACTIVE
  RENEWAL_AVAILABLE
  EXPIRED
  // Baja a pedido del titular: la licencia termina antes de tiempo. Es lo que
  // corresponde cuando el negocio se muda de local, porque la licencia vale
  // para el establecimiento y no para la empresa (Ley 28976).
  CANCELLED
}

enum DocumentType {
  FLOOR_PLAN
  RUC_RECORD
  ADDITIONAL
}

enum PaymentType {
  INITIAL_APPLICATION
  RENEWAL
}

enum PaymentStatus {
  COMPLETED
}

// Medios aceptados en caja (pago presencial, sin pasarela externa)
// Comprobante de pago. La boleta de venta se eliminó: el derecho de trámite lo
// paga siempre la empresa titular del RUC, así que no hay caso de persona
// natural. El campo se conserva con un único valor para dejar asentado que el
// cobro emitió comprobante — los pagos anteriores a la factura lo tienen null.
enum ReceiptType {
  FACTURA
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  YAPE
  PLIN
}

// FIRST y SECOND son las del trámite inicial. UNANNOUNCED es la visita de
// control que se agenda al renovar: cae en una fecha al azar dentro del año de
// la licencia renovada y el administrado no la conoce de antemano.
enum InspectionNumber {
  FIRST
  SECOND
  UNANNOUNCED
}

enum InspectionStatus {
  SCHEDULED
  COMPLETED
}

enum InspectionResult {
  APPROVED
  REJECTED
}

enum FineStatus {
  ISSUED
  PAID
}

// ─── Usuario (Solicitante / Inspector) ───────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  dni          String
  phone        String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications Application[] @relation("ApplicantApplications")
  inspections  Inspection[]  @relation("InspectorInspections")
  fines        Fine[]        @relation("InspectorFines")
  registrations Application[] @relation("CashierRegistrations")
  cashPayments  Payment[]     @relation("CashierPayments")
  auditLogs     AuditLog[]    @relation("UserAuditLogs")
  notifications Notification[] @relation("UserNotifications")
  cashSessions   CashSession[] @relation("CashierSessions")
  closedSessions CashSession[] @relation("AdminClosedSessions")
  cashMovements  CashMovement[] @relation("AdminCashMovements")

  @@index([role])
  @@index([active])
}

// ─── Negocio ─────────────────────────────────────────────────────────────────

model Business {
  id                String   @id @default(cuid())
  legalName         String
  ruc               String   @unique
  fiscalAddress     String
  // Obligatorios: la base los tiene NOT NULL y todos los caminos de alta los
  // completan (con "No registrado" cuando el dato no se releva).
  commercialAddress String
  activityType      String

  representativeName  String
  representativeDni   String
  representativeRole  String
  representativePhone String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]

  @@index([legalName])
}

// ─── Trámite (Application) ───────────────────────────────────────────────────

model Application {
  id          String            @id @default(cuid())
  number      String            @unique
  status      ApplicationStatus @default(DRAFT)
  dataLocked  Boolean           @default(false)

  applicantId String
  businessId  String

  // Cajero que registró el trámite de forma presencial (null si fue autogestión)
  registeredById String?

  // Correo de contacto que declara el ciudadano al iniciar el trámite. Va acá
  // y no en User.email: ese campo es @unique y el flujo público lo usa con un
  // valor sintético, así que dos trámites con el mismo Gmail chocarían.
  contactEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicant   User         @relation("ApplicantApplications", fields: [applicantId], references: [id], onDelete: Restrict)
  registeredBy User?       @relation("CashierRegistrations", fields: [registeredById], references: [id], onDelete: SetNull)
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  documents   Document[]
  payments    Payment[]
  inspections Inspection[]
  license     License?

  @@index([applicantId])
  @@index([businessId])
  @@index([status])
  @@index([registeredById])
}

// ─── Documento (binario en BD) ───────────────────────────────────────────────

model Document {
  id                    String       @id @default(cuid())
  applicationId         String
  type                  DocumentType
  name                  String
  fileName              String
  mimeType              String
  size                  Int
  content               Bytes
  additionalDocumentName String?
  createdAt             DateTime     @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([type])
}

// ─── Pago simulado ─────────────────────────────────────────────────────────────

model Payment {
  id              String        @id @default(cuid())
  applicationId   String
  type            PaymentType
  amount          Decimal       @db.Decimal(10, 2)
  operationNumber String        @unique
  status          PaymentStatus @default(COMPLETED)
  paidAt          DateTime
  createdAt       DateTime      @default(now())

  // Cobro en ventanilla: medio de pago y cajero que lo recibió.
  // Nulos en los pagos que no pasaron por caja.
  method         PaymentMethod?
  registeredById String?

  // Solo en cobros en efectivo: con cuánto pagó el contribuyente y cuánto se
  // le devolvió. No alteran el neto de la caja (recibido menos vuelto es
  // siempre el importe), pero dejan la traza de la operación de ventanilla.
  receivedAmount Decimal? @db.Decimal(10, 2)
  changeGiven    Decimal? @db.Decimal(10, 2)

  // Comprobante que pidió el contribuyente. Se elige al cobrar y define la
  // serie del documento, así que no puede decidirse recién al descargarlo.
  receiptType ReceiptType?

  // Código de operación que muestra la app del contribuyente al yapear.
  //
  // Va aparte de `operationNumber`, que es el identificador interno de la
  // municipalidad y es @unique: un código ajeno mal tipeado que chocara con
  // otro haría fallar el cobro entero. Acá no hay restricción de unicidad
  // porque el dato lo transcribe una persona mirando un celular.
  externalReference String?

  application  Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  registeredBy User?       @relation("CashierPayments", fields: [registeredById], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([type])
  @@index([registeredById])
  @@index([paidAt])
}

// ─── Notificaciones internas ───────────────────────────────────────────────────

enum NotificationType {
  // Dirigidas al administrado
  INSPECTION_TODAY
  INSPECTION_RESCHEDULED
  DOCUMENTS_TO_FIX
  LICENSE_EXPIRED
  // Dirigidas al inspector
  INSPECTOR_TODAY_AGENDA
  INSPECTOR_NEW_ASSIGNMENT
  // Dirigidas al administrador
  ADMIN_CASH_OPEN_REQUEST
  ADMIN_CASH_CLOSE_REQUEST
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  type          NotificationType
  title         String
  message       String
  applicationId String?
  // Clave de deduplicación: evita repetir el mismo aviso el mismo día.
  dedupeKey     String?          @unique
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ─── Auditoría de acciones ─────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  userId     String?
  details    Json?
  createdAt  DateTime @default(now())

  user User? @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Inspección ────────────────────────────────────────────────────────────────

model Inspection {
  id            String            @id @default(cuid())
  applicationId String
  inspectorId   String
  number        InspectionNumber
  status        InspectionStatus  @default(SCHEDULED)
  scheduledAt   DateTime
  result        InspectionResult?
  observations  String?
  resultAt      DateTime?
  createdAt     DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  inspector   User        @relation("InspectorInspections", fields: [inspectorId], references: [id], onDelete: Restrict)

  // Un inspector no puede tener dos inspecciones en el mismo horario.
  // Se garantiza en la base, no solo en el código.
  @@unique([inspectorId, scheduledAt])
  @@index([applicationId])
  @@index([inspectorId])
  @@index([scheduledAt])
  @@index([status])
}

// ─── Licencia (PDF en BD) ──────────────────────────────────────────────────────

model License {
  id            String        @id @default(cuid())
  applicationId String        @unique
  licenseNumber String        @unique
  issuedAt      DateTime
  expiresAt     DateTime
  status        LicenseStatus @default(ACTIVE)
  pdfContent    Bytes
  pdfFileName   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  fines       Fine[]

  @@index([status])
  @@index([expiresAt])
}

// ─── Multa (inspección inopinada u observación post-emisión) ───────────────────

model Fine {
  id           String     @id @default(cuid())
  licenseId    String
  inspectorId  String
  amount       Decimal    @db.Decimal(10, 2)
  description  String
  observations String?
  status       FineStatus @default(ISSUED)
  issuedAt     DateTime
  createdAt    DateTime   @default(now())

  license   License @relation(fields: [licenseId], references: [id], onDelete: Restrict)
  inspector User    @relation("InspectorFines", fields: [inspectorId], references: [id], onDelete: Restrict)

  @@index([licenseId])
  @@index([inspectorId])
  @@index([status])
  @@index([issuedAt])
}

// ─── Configuración del Sistema (Simulación de Tiempo) ──────────────────────────

model SystemConfig {
  id            String   @id @default("singleton")
  simulatedDate DateTime @default(now())
}

// Tarifa del derecho de trámite, que el administrador puede cambiar.
//
// Fila única. Si no existe, rige DEFAULT_TUPA_AMOUNT: la ausencia significa
// "valor de fábrica", el mismo criterio que SystemConfig con el reloj. Por eso
// el restablecer la borra en lugar de escribirle 180.
model Tarifa {
  id        String   @id @default("singleton")
  amount    Decimal  @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt
}

// Valor de la UIT, del que salen los montos de las multas. Cambia por decreto
// todos los años, así que se configura en vez de vivir en el código. Misma
// forma que Tarifa: una sola fila, y sin fila rige el valor de fábrica.
model Uit {
  id        String   @id @default("singleton")
  amount    Decimal  @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt
}

// ─── Simulación de tiempo (demostración académica) ─────────────────────────────

enum SimulationStatus {
  RUNNING
  RESTORED
}

enum SimulationOperation {
  CREATE
  UPDATE
  DELETE
}

//
// Una corrida de simulación de tiempo.
//
// Empieza al adelantar el reloj y termina al restablecerlo. Mientras corre,
// cada escritura en la base queda anotada en SimulationChange.
model SimulationRun {
  id               String           @id @default(cuid())
  status           SimulationStatus @default(RUNNING)
  realStartedAt    DateTime         @default(now())
  simulatedStartAt DateTime
  simulatedEndAt   DateTime?
  restoredAt       DateTime?
  startedByEmail   String?

  changes SimulationChange[]

  @@index([status])
  @@index([realStartedAt])
}

//
// Una escritura ocurrida durante la simulación.
//
// `before` guarda el estado previo de la fila, lo que permite deshacer el
// cambio al restablecer: borrar lo creado y devolver lo modificado.
model SimulationChange {
  id          String              @id @default(cuid())
  runId       String
  model       String
  operation   SimulationOperation
  recordId    String?
  before      Json?
  after       Json?
  description String?
  createdAt   DateTime            @default(now())

  run SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([model])
  @@index([createdAt])
}

// ─── Caché de consultas de RUC (ahorro de cuota en APIPERU) ────────────────────

model RucCache {
  ruc       String   @id
  payload   Json
  fetchedAt DateTime @default(now())

  @@index([fetchedAt])
}

// Establecimientos anexos del RUC. Va en su propia tabla y no dentro de
// RucCache porque sale de otro endpoint de APIPERU, con su propio consumo de
// cuota: mezclarlos obligaría a pedir los dos cada vez que vence uno.
model RucAnexosCache {
  ruc       String   @id
  payload   Json
  fetchedAt DateTime @default(now())

  @@index([fetchedAt])
}

// Caché de consultas de DNI a RENIEC (mismo ahorro de cuota que el RUC)
model DniCache {
  dni       String   @id
  payload   Json
  fetchedAt DateTime @default(now())

  @@index([fetchedAt])
}

// ─── Caja ────────────────────────────────────────────────────────────────────

// Apertura y cierre pasan los dos por el administrador, así que el turno vive
// la mitad del tiempo esperando una decisión: PENDING_OPEN antes de operar y
// PENDING_APPROVAL antes de cerrarse. REJECTED es una apertura que el admin no
// autorizó; el rechazo de un cierre devuelve el turno a OPEN y no deja estado
// propio, porque la caja sigue operativa.
enum CashSessionStatus {
  PENDING_OPEN
  OPEN
  PENDING_APPROVAL
  CLOSED
  REJECTED
}

// Turno de caja de un cajero: se solicita con un fondo, el administrador lo
// autoriza, se cobra contra él y se cierra contando el efectivo. Sin turno
// abierto no se puede registrar pagos.
model CashSession {
  id            String            @id @default(cuid())
  cashierId     String
  openingAmount Decimal           @db.Decimal(10, 2)
  openedAt      DateTime
  // El turno nace pidiendo autorización: nadie abre su propia caja.
  status        CashSessionStatus @default(PENDING_OPEN)

  // Se congelan al cerrar: el arqueo posterior no debe cambiar lo que se
  // declaró en el momento del cierre. Un cierre rechazado los limpia: dejar el
  // conteo viejo mostraría un descuadre que el cajero ya está recontando.
  cashCollected    Decimal? @db.Decimal(10, 2)
  digitalCollected Decimal? @db.Decimal(10, 2)
  expectedAmount   Decimal? @db.Decimal(10, 2)
  countedAmount    Decimal? @db.Decimal(10, 2)
  difference       Decimal? @db.Decimal(10, 2)

  // Texto que acompaña lo último que se decidió sobre el turno: el motivo del
  // descuadre que declara el cajero, o el motivo con el que el administrador
  // rechazó la apertura o el cierre.
  justification String?

  // Quién resolvió la última solicitud del turno, sea la apertura o el cierre.
  closedById String?
  closedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cashier   User           @relation("CashierSessions", fields: [cashierId], references: [id], onDelete: Restrict)
  closedBy  User?          @relation("AdminClosedSessions", fields: [closedById], references: [id], onDelete: SetNull)
  movements CashMovement[]

  @@index([cashierId])
  @@index([status])
  @@index([openedAt])
}

// Movimientos de efectivo que hace el administrador sobre una caja abierta:
// le entrega más sencillo o le retira parte de la recaudación a bóveda.
//
// Solo alcanzan al efectivo. Lo cobrado por Yape va directo a la cuenta
// digital de la municipalidad y nunca pasa por el cajón, así que no hay nada
// que entregar ni retirar de eso.
enum CashMovementType {
  DEPOSIT
  WITHDRAWAL
}

model CashMovement {
  id        String           @id @default(cuid())
  sessionId String
  type      CashMovementType
  // Siempre positivo: el signo lo da el tipo. Con un monto con signo se podría
  // escribir una "reposición de -200", que no significa nada.
  amount    Decimal          @db.Decimal(10, 2)
  reason    String

  // Siempre un administrador: el cajero no mueve el fondo de su propia caja.
  createdById String
  createdAt   DateTime

  session   CashSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy User        @relation("AdminCashMovements", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([sessionId])
}
