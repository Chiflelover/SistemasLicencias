# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno.
#
# Copiar como .env y completar con valores propios:
#   cp .env.example .env
#
# El archivo .env está en .gitignore y nunca debe subirse al repositorio.
# ─────────────────────────────────────────────────────────────────────────────


# ── OBLIGATORIAS ─────────────────────────────────────────────────────────────

# PostgreSQL (Neon, Supabase o local).
DATABASE_URL="postgresql://usuario:password@host:5432/licencias_trujillo?sslmode=require"

# Consulta de RUC en SUNAT a través de APIPERU (https://apiperu.dev).
# Sin este token no se puede iniciar ningún trámite: el sistema valida el RUC
# y el distrito antes de registrar el negocio.
APIPERU_TOKEN="tu_token_de_apiperu"

# Clave para firmar los tokens de sesión (JWT).
# Usar una cadena larga y aleatoria. Si se omite, el código cae a un valor
# por defecto que NO debe usarse fuera de desarrollo.
JWT_SECRET="cambiar_por_una_cadena_larga_y_aleatoria"


# ── SIMULADOR DE TIEMPO (demostración) ───────────────────────────────────────

# Habilita el panel flotante que permite adelantar el reloj del sistema para
# demostrar vencimientos, renovaciones y la agenda del inspector sin esperar.
#
# Apagado (o ausente): la fecha es siempre la real y el panel no aparece.
# En "true": el reloj puede adelantarse, y todo cambio hecho durante la
# simulación queda registrado y se deshace al restablecer la fecha.
#
# Pensado para entornos de demostración. En una instalación real, dejar apagado.
ENABLE_TIME_SIMULATOR="false"


# ── AVISOS AL ADMINISTRADO (opcional) ────────────────────────────────────────

# Cuenta de Gmail desde la que salen los correos al ciudadano: licencia
# vencida, inspección de hoy, observación de la primera inspección y rechazo
# del trámite.
#
# La contraseña NO es la de la cuenta: hay que generar una "contraseña de
# aplicación" en Cuenta de Google → Seguridad, con la verificación en dos pasos
# activada. Google la muestra en grupos de cuatro; el código quita los espacios,
# así que da igual cómo se pegue.
#
# Sin estas dos variables no se manda ningún correo, y nada falla.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Aviso por WhatsApp de la agenda del día, a través de CallMeBot.
#
# El bot gratuito entrega a un ÚNICO número, el que lo autorizó: por eso está
# dedicado al inspector y no al ciudadano. El teléfono va con código de país,
# por ejemplo "+51987654321".
#
# Sin estas dos variables no se manda el aviso, y nada falla.
CALLMEBOT_PHONE=""
CALLMEBOT_APIKEY=""


# ── COBRO EN LÍNEA (opcional) ────────────────────────────────────────────────

# Enlace de cobro generado en el panel de Flow (Link de pago).
#
# Con esta variable, la pantalla de pago del flujo público muestra un botón
# "Pagar con Flow" antes de la carga del comprobante. El ciudadano paga, guarda
# la constancia y la sube para que el sistema registre el pago y agende la
# inspección.
#
# Sin la variable, el botón no se muestra y queda solo la carga del comprobante.
FLOW_PAYMENT_URL=""


# ── ENTORNO ──────────────────────────────────────────────────────────────────

# URL pública de la aplicación.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# development | production
# En development se habilita el simulador de fechas del DevPanel.
NODE_ENV="development"
